# Provider: openai | anthropic | gemini | mock (default: mock when no key is set)
GRADPILOT_LLM_PROVIDER=mock
GRADPILOT_LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Frontend
VITE_API_BASE=http://localhost:8000
VITE_ADSENSE_CLIENT=

# --- Bring your own key ---
# Users can paste their own key in the UI; it is sent per request and never stored.

# --- Paid runs (toyyibPay) ---
# Credits must survive a redeploy, so checkout stays OFF until Supabase is set.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
TOYYIBPAY_SECRET=
TOYYIBPAY_CATEGORY=
TOYYIBPAY_SANDBOX=1
PUBLIC_APP_URL=https://grad-pilot-inky.vercel.app
PUBLIC_API_URL=https://gradpilot-api.onrender.com
